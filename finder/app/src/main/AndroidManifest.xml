<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="space.nami.browser" />
    </queries>
    <application
        android:label="Nami 파인더"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Finder"
        android:supportsRtl="true">
        <!-- the search window: opened by the home-screen widget (and by the app icon) -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:enableOnBackInvokedCallback="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PixivLogin"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <receiver android:name=".FinderWidget" android:exported="true" android:label="Nami 검색">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/finder_widget" />
        </receiver>
    </application>
</manifest>
